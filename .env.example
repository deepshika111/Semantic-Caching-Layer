# --- LLM providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# openai | anthropic | ollama | mock
# mock = deterministic local provider + hash embeddings (no paid API)
PROVIDER_MODE=mock
DEFAULT_PROVIDER=openai

# --- Redis ---
REDIS_URL=redis://localhost:6379
CACHE_BACKEND=redis
REDIS_INDEX_NAME=semantic_cache
REDIS_KEY_PREFIX=scache

# memory is for tests / local runs without Redis Stack
# CACHE_BACKEND=memory

# --- Cache behavior ---
CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
NEAR_MISS_DELTA=0.05
DEFAULT_CACHE_TTL_SECONDS=86400
TEMPORAL_CACHE_TTL_SECONDS=3600
TEMPORAL_CACHE_MODE=short_ttl
CREATIVE_CACHE_ENABLED=true
CREATIVE_THRESHOLD=0.98
CLASSIFICATION_THRESHOLD=0.90
FACTUAL_THRESHOLD=0.95
MAX_CACHE_ENTRIES=100000
CACHE_SEARCH_TOP_K=8

# --- Embeddings ---
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=15

# --- Proxy ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
DEBUG_CACHE_HEADERS=false
PROMPT_RETENTION_ENABLED=false
DECISION_LOG_MAX_ENTRIES=10000

# --- Admin ---
# Required to call /admin/* endpoints. Generate a long random token.
ADMIN_API_KEY=change-me-to-a-long-random-token

# --- Timeouts ---
PROVIDER_TIMEOUT_SECONDS=120
